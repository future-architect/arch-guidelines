{
  "filters": {
    "comments": true,
    "allowlist": {
        "allow": [
          "/:::.*/",
          "/.*:/",
          "/【.*】/",
          "/✅️.*/",
          "/❌️.*/",
          "/🆖.+/",
          "ジョブスケジューラ",
          "単体テスト",
          "データスチュワード",
          "スチュワード",
          "@timestamp",
          "フラッシュ",
          "デグレ",
          "「使うかもしれない」",
          "**データは資産**: データは",
          "最強",
          "配配メール",
          "「今持っている情報は、明日には間違っているかもしれない」",
          "～いきつけのジムでパーソナルトレーニングを受けよう～",
          "/●+/",
          "/〇+/",
          "/○+/",
          "/▲+/",
          "/△+/",
          "/×+/",
          "/◇+/",
          "/……/",
          "【アップデート】Security Hub 通知のフィルタルールを EventBridge から簡単に作成できます",
          "Aurora DB クラスターへのデータの追加と、Amazon Redshift でのクエリ - Amazon Aurora",
          "Amazon Aurora PostgreSQL DB クラスターのアップグレード",
          "List-Unsubscribeヘッダ付与機能 | メール配信システムWEBCAS e-mail",
          "URLリソースの非推奨を示すDeprecationヘッダ \\- ASnoKaze blog",
          "Idempotency-Keyヘッダによるマイクロサービスの冪等性の担保",
          "Server-Timing ヘッダの情報をフロントエンド解析に使う",
          "CSS コンテナークエリー | MDN"
        ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "no-mix-dearu-desumasu": {
        "preferInHeader": "である",
        "preferInBody": "である"
      },
      "allowQuestionMark": true,
      "sentence-length": {
        "max": 200
      },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": true,
      "max-kanji-continuous-len": {
        "max": 10
      }
    },
    "prh": {
      "rulePaths": ["./prh-choon.yml"]
    }
  }
}
