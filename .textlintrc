{
  "filters": {
    "comments": true,
    "allowlist": {
        "allow": [
          "/:::.*/",
          "/.*:/",
          "/【.*】/",
          "/✅️.*/",
          "/❌️.*/",
          "/🆖.+/",
          "ジョブスケジューラ",
          "単体テスト",
          "データスチュワード",
          "スチュワード",
          "@timestamp",
          "フラッシュ",
          "デグレ",
          "「使うかもしれない」",
          "**データは資産**: データは",
          "最強",
          "配配メール",
          "「今持っている情報は、明日には間違っているかもしれない」",
          "～いきつけのジムでパーソナルトレーニングを受けよう～",
          "/●+/",
          "/〇+/",
          "/○+/",
          "/▲+/",
          "/△+/",
          "/×+/",
          "/◇+/",
          "/……/"
        ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "no-mix-dearu-desumasu": {
        "preferInHeader": "である",
        "preferInBody": "である"
      },
      "allowQuestionMark": true,
      "sentence-length": {
        "max": 200
      },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": true,
      "max-kanji-continuous-len": {
        "max": 10
      }
    }
  }
}
